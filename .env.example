# AI Provider Configuration
AUTOHEAL_AI_PROVIDER=GOOGLE_GEMINI
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# AI Model Configuration
AUTOHEAL_AI_MODEL=gemini-2.0-flash
AUTOHEAL_AI_TIMEOUT=30000
AUTOHEAL_AI_VISUAL_ENABLED=true

# ============================================
# LOCAL/Custom AI Model Configuration
# ============================================
# Use these when AUTOHEAL_AI_PROVIDER=LOCAL or when you want to use local models
# Supports: localhost, Cloudflare tunnels, ngrok, Ollama, custom endpoints

# Option 1: Simple format (recommended)
LOCAL_MODEL_URL=https://your-tunnel.trycloudflare.com
LOCAL_MODEL_API_PATH=/v1/chat/completions
LOCAL_MODEL_NAME=deepseek-coder-v2:16b
LOCAL_MODEL_FORMAT=openai
LOCAL_MODEL_TIMEOUT=60000
LOCAL_MODEL_TEMPERATURE=0.1
LOCAL_MODEL_MAX_TOKENS=2048

# Option 2: Prefixed format (alternative)
# AUTOHEAL_LOCAL_MODEL_URL=https://your-tunnel.trycloudflare.com
# AUTOHEAL_LOCAL_MODEL_API_PATH=/v1/chat/completions
# AUTOHEAL_LOCAL_MODEL_NAME=deepseek-coder-v2:16b
# AUTOHEAL_LOCAL_MODEL_FORMAT=openai

# Example configurations:
# -----------------------
# Localhost OpenAI-compatible:
# LOCAL_MODEL_URL=http://localhost:8000
# LOCAL_MODEL_API_PATH=/v1/chat/completions
# LOCAL_MODEL_FORMAT=openai

# Cloudflare tunnel:
# LOCAL_MODEL_URL=https://abc.trycloudflare.com
# LOCAL_MODEL_API_PATH=/v1/chat/completions
# LOCAL_MODEL_NAME=deepseek-coder-v2:16b

# Ollama:
# LOCAL_MODEL_URL=http://localhost:11434
# LOCAL_MODEL_API_PATH=/api/generate
# LOCAL_MODEL_FORMAT=ollama
# LOCAL_MODEL_NAME=llama2

# ngrok:
# LOCAL_MODEL_URL=https://abc123.ngrok.io
# LOCAL_MODEL_API_PATH=/v1/chat/completions

# Cache Configuration
AUTOHEAL_CACHE_TYPE=PERSISTENT_FILE
AUTOHEAL_CACHE_MAX_SIZE=10000
AUTOHEAL_CACHE_EXPIRE_AFTER_WRITE=86400000

# Performance Configuration
AUTOHEAL_EXECUTION_STRATEGY=SMART_SEQUENTIAL
AUTOHEAL_THREAD_POOL_SIZE=4
AUTOHEAL_ELEMENT_TIMEOUT=30000

# Reporting Configuration
AUTOHEAL_REPORTING_ENABLED=true
AUTOHEAL_REPORTING_HTML=true
AUTOHEAL_REPORTING_JSON=true
AUTOHEAL_REPORTING_OUTPUT_DIR=./autoheal-reports

# Debug Configuration
AUTOHEAL_DEBUG_MODE=false
AUTOHEAL_SAVE_SCREENSHOTS=false
